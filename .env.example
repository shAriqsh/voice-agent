# Local testing (Windows):
# 1. Start Docker Desktop and run: docker-compose up -d
# 2. Run checks via: powershell -ExecutionPolicy Bypass -File scripts/check.ps1
#    (Agents running pytest integration tests need BypassSandbox: true for localhost ports 5432, 6379, 6333.)

# Control-Plane API authentication
ADMIN_API_KEY=change-me-platform-admin-key

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://voice_agent:voice_agent@localhost:5432/voice_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# LiveKit & SIP
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_dev_key_replace_in_production_32chars
